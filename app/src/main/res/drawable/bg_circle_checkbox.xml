<?xml version="1.0" encoding="utf-8"?>
<!-- Circular checkbox button for the backup content rows: ring when unchecked,
     blue filled circle with white check when checked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/ic_circle_checked" />
    <item android:drawable="@drawable/ic_circle_unchecked" />
</selector>
