<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nkb_page"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingBottom="6dp"
            android:text="@string/backup_content"
            android:textColor="@color/nkb_text_hint"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nkb_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nkb_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/backup_configurations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@drawable/bg_circle_checkbox_inset"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false"
                    android:checked="true"
                    android:gravity="left|center_vertical"
                    android:layoutDirection="rtl"
                    android:padding="13dp"
                    android:text="@string/backup_groups_and_configurations"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nkb_divider" />

                <CheckBox
                    android:id="@+id/backup_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@drawable/bg_circle_checkbox_inset"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false"
                    android:checked="true"
                    android:gravity="left|center_vertical"
                    android:layoutDirection="rtl"
                    android:padding="13dp"
                    android:text="@string/backup_rules"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nkb_divider" />

                <CheckBox
                    android:id="@+id/backup_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@drawable/bg_circle_checkbox_inset"
                    app:buttonTint="@null"
                    app:useMaterialThemeColors="false"
                    android:checked="true"
                    android:gravity="left|center_vertical"
                    android:layoutDirection="rtl"
                    android:padding="13dp"
                    android:text="@string/backup_settings"
                    android:textAppearance="?attr/textAppearanceSubtitle2" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="20dp"
            android:paddingBottom="6dp"
            android:text="@string/action_export"
            android:textColor="@color/nkb_text_hint"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nkb_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nkb_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/action_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_export_backup"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/nkb_text_hint"
                        android:textSize="14sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nkb_divider" />

                <LinearLayout
                    android:id="@+id/action_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_share_backup"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/nkb_text_hint"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="20dp"
            android:paddingBottom="6dp"
            android:text="@string/backup_import"
            android:textColor="@color/nkb_text_hint"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nkb_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nkb_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/action_import_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_import_file"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/nkb_text_hint"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/nkb_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nkb_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/reset_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reset_settings"
                    android:textColor="@color/nkb_latency_bad"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/backup_summary"
            android:textColor="?android:textColorTertiary"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
