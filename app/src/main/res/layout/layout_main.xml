<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nkb_page">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/fragment_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="0dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dock"
        android:elevation="8dp"
        app:itemBackground="@drawable/dock_item_bg"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/dock_item_tint"
        app:itemPaddingBottom="5dp"
        app:itemPaddingTop="5dp"
        app:itemTextAppearanceActive="@style/NkbDockLabel"
        app:itemTextAppearanceInactive="@style/NkbDockLabel"
        app:itemTextColor="@color/dock_item_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_dock_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
